---
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/delman.css";
import "katex/dist/katex-swap.css";
import { Content, frontmatter } from "../paper.mdx";
const { title, description, favicon, thumbnail } = frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
const social = Astro.site
  ? new URL(base + thumbnail, Astro.site).href
  : base + thumbnail;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c5c45" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={base + favicon} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={social} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-google-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#impact">Skip to content</a>
    <main><Content /></main>
    <footer class="page-footer">
      <p>
        Built with <a
          href="https://research-template.roman.technology/"
          target="_blank"
          rel="noopener noreferrer"
          >Roman Hauksson-Neill’s project page template</a
        >.
      </p>
    </footer>
  </body>
</html>
