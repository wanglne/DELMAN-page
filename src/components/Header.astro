---
import { Icon } from "astro-icon/components";
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const authors = [
  { name: "Yi Wang", url: "https://wanglne.github.io/", note: "1" },
  {
    name: "Fenghua Weng",
    url: "https://openreview.net/profile?id=~Fenghua_Weng1",
    note: "1",
  },
  { name: "Sibei Yang", url: "https://sibeiyang.github.io/", note: "2" },
  { name: "Zhan Qin", url: "https://person.zju.edu.cn/en/zhanqin", note: "3" },
  {
    name: "Minlie Huang",
    url: "https://coai.cs.tsinghua.edu.cn/hml",
    note: "4",
  },
  { name: "Wenjie Wang", url: "https://wwj95.github.io/", note: "1†" },
];
const links = [
  {
    name: "Paper",
    url: "https://aclanthology.org/2025.findings-acl.598.pdf",
    icon: "ri:file-pdf-2-line",
  },
  {
    name: "Code",
    url: "https://github.com/wanglne/DELMAN",
    icon: "ri:github-line",
  },
  {
    name: "arXiv",
    url: "https://arxiv.org/abs/2502.11647",
    icon: "academicons:arxiv",
  },
  {
    name: "ACL Anthology",
    url: "https://aclanthology.org/2025.findings-acl.598/",
    icon: "ri:article-line",
  },
];
---

<header class="publication-header full-bleed">
  <div class="header-inner">
    <h1 class="publication-title">
      DELMAN: Dynamic Defense Against Large Language Model Jailbreaking with
      Model Editing
    </h1>
    <svg
      class="conference-logo"
      viewBox="0 288 930 134"
      role="img"
      aria-label="ACL 2025"
    >
      <defs>
        <filter id="acl-logo-red" color-interpolation-filters="sRGB">
          <feFlood flood-color="#ed1c24" result="logoRed"></feFlood>
          <feComposite in="logoRed" in2="SourceAlpha" operator="in"
          ></feComposite>
        </filter>
      </defs>
      <image
        href={base + "acl2025-logo.png"}
        width="1920"
        height="655"
        filter="url(#acl-logo-red)"
      />
    </svg>
    <div class="authors">
      {
        authors.map((author) => (
          <span>
            <a href={author.url} target="_blank" rel="noopener noreferrer">
              {author.name}
            </a>
            <sup>{author.note}</sup>
          </span>
        ))
      }
    </div>
    <div class="affiliation-main">
      <p><sup>1</sup>ShanghaiTech University</p><img
        src={base + "aspire-transparent.png"}
        alt="ASPIRE — AI Security, Privacy and Robustness"
        width="1895"
        height="830"
      />
    </div>
    <div class="affiliations">
      <span><sup>2</sup>Sun Yat-sen University</span><span
        ><sup>3</sup>Zhejiang University</span
      ><span><sup>4</sup>Tsinghua University</span>
    </div>
    <p class="author-notes"><sup>†</sup>Corresponding author.</p>
    <div class="publication-links">
      {
        links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <>
              <Icon name={link.icon} />
              <span>{link.name}</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
</header>
